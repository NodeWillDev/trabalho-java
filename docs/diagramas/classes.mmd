classDiagram
    class Categoria {
        -int id
        -String nome
        -String descricao
    }
    class Usuario {
        -int id
        -String nome
        -String email
        -String telefone
        -String cpf
    }
    class Livro {
        -int id
        -String titulo
        -String autor
        -String isbn
        -int anoPublicacao
        -int quantidade
        -int categoriaId
    }
    class Emprestimo {
        -int id
        -LocalDate dataEmprestimo
        -LocalDate dataDevolucao
        -String status
        -int usuarioId
        -int livroId
    }
    class Reserva {
        -int id
        -LocalDate dataReserva
        -String status
        -int usuarioId
        -int livroId
    }
    Categoria "1" -- "0..*" Livro : classifica
    Usuario "1" -- "0..*" Emprestimo : realiza
    Livro "1" -- "0..*" Emprestimo : participa
    Usuario "1" -- "0..*" Reserva : realiza
    Livro "1" -- "0..*" Reserva : possui
